{
  "name": "arrow2nd.com-gen3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build-images.mjs && vite",
    "build": "node scripts/build-images.mjs && vite build --mode client && vite build && node ./scripts/build-ssg.mjs",
    "preview": "wrangler dev",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "deploy": "wrangler deploy",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "budoux": "^0.10.0",
    "hono": "^4.13.13",
    "honox": "^0.1.61",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@fontsource/poppins": "^5.2.7",
    "@hono/vite-build": "^1.11.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/node": "^26.6.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
